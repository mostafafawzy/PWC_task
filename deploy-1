apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
  namespace: zone-1
  labels:
    app: nginx
spec:
  replicas: 2
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: tier
                    operator: In
                    values:
                      - frontend
      containers:
        - name: nginx
          image: nginx:1.25
          ports:
            - containerPort: 80
